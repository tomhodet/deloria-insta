    {
      "parameters": {},
      "name": "Lancement manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/tomhodet/deloria-insta/main/calendrier/calendrier.json",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Lire calendrier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pour un test, mettre une date du calendrier, par exemple '2026-10-21'. Laisser vide en production.\nconst DATE_FORCEE = '';\n\nconst aujourdhui = DATE_FORCEE || $now.setZone('Europe/Paris').toISODate();\nconst posts = $input.all().map(i => i.json);\nconst post = posts.find(p => p.date === aujourdhui);\n\nif (!post) {\n  return [{ json: { trouve: false, date: aujourdhui } }];\n}\nreturn [{ json: { trouve: true, date: post.date, image_url: post.image_url,\n  images: post.images || [], carrousel: post.type === 'carrousel', legende: post.legende } }];"
      },
      "name": "Post du jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.trouve }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Post prevu ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "url": "https://graph.instagram.com/17841434890046154/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "caption,timestamp"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        },
        "options": {}
      },
      "name": "Derniers posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Protection contre la double publication : si une exécution est relancée,\n// on ne republie pas un post dont la légende figure déjà parmi les derniers posts.\nconst post = $('Post du jour').first().json;\nconst debut = s => (s || '').replace(/\\s+/g, ' ').trim().slice(0, 80);\nconst recents = ($input.first().json.data || []).map(m => debut(m.caption));\nconst deja = recents.includes(debut(post.legende));\nreturn [{ json: { ...post, deja_publie: deja } }];"
      },
      "name": "Deja publie ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.deja_publie }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "A publier ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.instagram.com/17841434890046154/media",
