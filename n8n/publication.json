{
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 15 12 * * 1,3,5"
            }
          ]
        }
      },
      "name": "Lun Mer Ven 12h15",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "name": "Lancement manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/tomhodet/deloria-insta/main/calendrier/calendrier.json",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Lire calendrier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 100]
    },
    {
      "parameters": {
        "jsCode": "// Pour un test, mettre une date du calendrier, par exemple '2026-10-05'. Laisser vide en production.\nconst DATE_FORCEE = '';\n\nconst aujourdhui = DATE_FORCEE || $now.setZone('Europe/Paris').toISODate();\nconst posts = $input.all().map(i => i.json);\nconst post = posts.find(p => p.date === aujourdhui);\n\nif (!post) {\n  return [{ json: { trouve: false, date: aujourdhui } }];\n}\nreturn [{ json: { trouve: true, date: post.date, image_url: post.image_url, legende: post.legende } }];"
      },
      "name": "Post du jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.trouve }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Post prevu ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 100]
    },
    {
      "parameters": {
        "url": "https://graph.instagram.com/17841434890046154/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "caption,timestamp" },
            { "name": "limit", "value": "10" }
          ]
        },
        "options": {}
      },
      "name": "Derniers posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "jsCode": "// Protection contre la double publication : si une exécution est relancée,\n// on ne republie pas un post dont la légende figure déjà parmi les derniers posts.\nconst post = $('Post du jour').first().json;\nconst debut = s => (s || '').replace(/\\s+/g, ' ').trim().slice(0, 80);\nconst recents = ($input.first().json.data || []).map(m => debut(m.caption));\nconst deja = recents.includes(debut(post.legende));\nreturn [{ json: { ...post, deja_publie: deja } }];"
      },
      "name": "Deja publie ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.deja_publie }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "false", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "A publier ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.instagram.com/17841434890046154/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "image_url", "value": "={{ $json.image_url }}" },
            { "name": "caption", "value": "={{ $json.legende }}" }
          ]
        },
        "options": {}
      },
      "name": "Creer container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, -100]
    },
    {
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      },
      "name": "Attendre 60s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1920, -100],
      "webhookId": "deloria-insta-attente"
    },
    {
      "parameters": {
        "url": "=https://graph.instagram.com/{{ $('Creer container').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "status_code" }
          ]
        },
        "options": {}
      },
      "name": "Statut container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $json.status_code }}",
              "rightValue": "FINISHED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Container pret ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2400, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.instagram.com/17841434890046154/media_publish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "creation_id", "value": "={{ $('Creer container').item.json.id }}" }
          ]
        },
        "options": {}
      },
      "name": "Publier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, -200]
    },
    {
      "parameters": {
        "errorMessage": "=Publication Instagram du {{ $('Post du jour').item.json.date }} bloquée : le container n'est pas prêt (statut {{ $json.status_code }})."
      },
      "name": "Erreur container",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [2640, 0]
    }
  ],
  "connections": {
    "Lun Mer Ven 12h15": { "main": [[{ "node": "Lire calendrier", "type": "main", "index": 0 }]] },
    "Lancement manuel": { "main": [[{ "node": "Lire calendrier", "type": "main", "index": 0 }]] },
    "Lire calendrier": { "main": [[{ "node": "Post du jour", "type": "main", "index": 0 }]] },
    "Post du jour": { "main": [[{ "node": "Post prevu ?", "type": "main", "index": 0 }]] },
    "Post prevu ?": { "main": [[{ "node": "Derniers posts", "type": "main", "index": 0 }], []] },
    "Derniers posts": { "main": [[{ "node": "Deja publie ?", "type": "main", "index": 0 }]] },
    "Deja publie ?": { "main": [[{ "node": "A publier ?", "type": "main", "index": 0 }]] },
    "A publier ?": { "main": [[{ "node": "Creer container", "type": "main", "index": 0 }], []] },
    "Creer container": { "main": [[{ "node": "Attendre 60s", "type": "main", "index": 0 }]] },
    "Attendre 60s": { "main": [[{ "node": "Statut container", "type": "main", "index": 0 }]] },
    "Statut container": { "main": [[{ "node": "Container pret ?", "type": "main", "index": 0 }]] },
    "Container pret ?": { "main": [[{ "node": "Publier", "type": "main", "index": 0 }], [{ "node": "Erreur container", "type": "main", "index": 0 }]] }
  }
}
